# ── 依赖与构建产物 ────────────────────────────────────────────
node_modules/
web/dist/
.tmp/

# ── 运行时数据 ───────────────────────────────────────────────
# 模型密钥、题库与评测记录，一律不入库（首次启动自动生成）
data/

# ── 测试与覆盖率 ─────────────────────────────────────────────
coverage/
*.lcov
.vitest-cache/
htmlcov/

# ── 工具缓存 ─────────────────────────────────────────────────
.eslintcache
.cache/
.vite/

# ── 环境变量与凭证（勿提交）──────────────────────────────────
.env
.env.*
# 但模板必须入库：使用者据此初始化自己的 .env
!.env.example

# ── 编辑器 / 系统 ────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ── 日志 ─────────────────────────────────────────────────────
*.log
npm-debug.log*
pnpm-debug.log*

# ── 冗余 lock 文件（已用 pnpm，不再用 npm）────────────────────
package-lock.json

# ── 截图生成的临时裁切图（仅 _ 前缀，正式截图需入库）─────────
docs/screenshots/_*
