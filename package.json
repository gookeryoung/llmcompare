{
  "name": "dsh-model-tester",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AI 模型工作台 —— 模型接入、对话、题库管理、多模型横向对比",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node server/index.mjs",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "node server/index.mjs",
    "preview": "node server/index.mjs",
    "typecheck": "tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:api": "node scripts/with-server.mjs scripts/smoke.mjs",
    "test:ui": "node scripts/with-server.mjs --build scripts/ui-check.mjs",
    "test": "pnpm run typecheck && pnpm run lint && pnpm run test:unit && pnpm run test:api && pnpm run test:ui",
    "shots": "node scripts/with-server.mjs --build scripts/screenshot.mjs",
    "clean": "node scripts/clean.mjs",
    "doctor": "node scripts/doctor.mjs",
    "kill-port": "node scripts/kill-port.mjs"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.1.5",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@12.4.2"
}
