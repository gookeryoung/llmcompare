{
  "name": "dsh-model-tester",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AI 模型工作台 —— 模型接入、对话、题库管理、多模型横向对比",
  "scripts": {
    "install:all": "npm install",
    "dev": "node scripts/dev.mjs",
    "dev:api": "node server/index.mjs",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "preview": "node server/index.mjs",
    "start": "node server/index.mjs",
    "typecheck": "tsc -p web/tsconfig.json --noEmit",
    "test:api": "node scripts/smoke.mjs",
    "test:ui": "node scripts/ui-check.mjs",
    "test": "npm run typecheck && npm run test:api && npm run test:ui",
    "shots": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rehype-highlight": "^7.0.2",
    "highlight.js": "^11.11.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
